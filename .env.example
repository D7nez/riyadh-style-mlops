# Start offline first. Mock echoes text and is NOT a quality benchmark.
MODEL_BACKEND=mock
RETRIEVAL_BACKEND=tfidf
GROQ_API_KEY=
GENERATION_MODEL=openai/gpt-oss-120b
ANALYSIS_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=intfloat/multilingual-e5-base
TOP_K=3
TEMPERATURE=0.6
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=riyadh-style
# Set false to inspect text in traces, only with approved non-sensitive inputs.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
APP_API_KEY=

# Optional JSON: per-million-token USD rates, keyed by each generation AND analysis model.
# Costs remain absent until you supply rates verified with your provider.
MODEL_PRICES_JSON={}

# Reuse Ollama running on Windows, reached from Docker Desktop.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=600
OLLAMA_NUM_CTX=8192
# Lightweight image uses TF-IDF. Set true + rebuild only if you need E5.
INSTALL_SEMANTIC=false
